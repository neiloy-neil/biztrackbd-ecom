// ==========================================
// STOREFRONT: STORE DETAILS, MANUAL PAYMENT NUMBERS AND CUSTOMER SIGN-IN
// ==========================================

// One row per store. What the storefront shows about the business and where customers send manual mobile-money payments
// (AdmStoreDetails and AdmPayments on the canvas). Not secrets: these numbers are shown to customers at checkout.
model StoreSettings {
  id                         String    @id @default(cuid())
  tenantId                   String    @unique
  storeName                  String
  tagline                    String?
  contactPhone               String? // shown in the footer and on the offline page
  whatsappNumber             String?
  facebookUrl                String?
  instagramUrl               String?
  addressLine                String?
  logoUrl                    String?
  announcement               String? // the thin bar above the header
  announcementBn             String?
  flashSaleActive            Boolean   @default(false)
  flashSaleEndsAt            DateTime?
  flashSaleCoupon            String?
  bkashNumber                String? // customers send money here when they choose bKash
  bkashKind                  String    @default("PERSONAL") // "PERSONAL" | "AGENT" | "MERCHANT"
  nagadNumber                String?
  nagadKind                  String    @default("PERSONAL")
  paymentNote                String? // extra line under the payment steps
  offlineMessage             String?
  storeNameBn                String?
  description                String? // search engines and social previews
  email                      String? // for customers
  pickupAddress              String? // used for couriers and printed on invoices
  ordersPaused               Boolean   @default(false) // the owner closed the store for now: no new orders, a notice instead
  // Payment rules (AdmPayments)
  codEnabled                 Boolean   @default(true)
  codFee                     Decimal   @default(0.00) @db.Decimal(12, 2) // added to the total when the customer pays cash on delivery
  codMaxAmount               Decimal?  @db.Decimal(12, 2) // cash on delivery is not offered above this order total
  bkashEnabled               Boolean   @default(true)
  nagadEnabled               Boolean   @default(true)
  bkashInstruction           String?
  nagadInstruction           String?
  invoiceFooter              String?
  invoiceOptions             Json      @default("{}") // { showLogo, showSku, showQr, showPricesOnSlip }
  // What the courier charges the owner (not the customer). Used to check statements and for the profit screen when the courier has not told us.
  courierFeeInsideDhaka      Decimal   @default(70.00) @db.Decimal(12, 2)
  courierFeeOutsideDhaka     Decimal   @default(130.00) @db.Decimal(12, 2)
  courierCodFeePercent       Decimal   @default(1.00) @db.Decimal(5, 2)
  defaultCourier             String? // preselected on the order screen
  courierToleranceAmount     Decimal   @default(10.00) @db.Decimal(12, 2) // Auto-tolerance variance in Taka
  courierAutoRestockOnReturn Boolean   @default(false) // Require physical warehouse check before restock
  reviewsAutoPublish         Boolean   @default(false) // off: a new review waits for the owner (AdmReviews)
  abandonedSmsEnabled        Boolean   @default(true) // send the 30-minute recovery SMS
  metaPixelId                String? // the public Meta (Facebook) Pixel id; the server-side token lives in the vault as META_CAPI
  googleAnalyticsId          String? // GA4 Measurement ID (e.g. G-XXXXXXXXXX)
  googleTagManagerId         String? // GTM Container ID (e.g. GTM-XXXXXXX)
  tiktokPixelId              String? // TikTok Pixel ID (e.g. CXXXXXXXXXXXXX)
  ga4ApiSecret               String? // GA4 Measurement Protocol API Secret for server-side events
  metaDomainVerification     String? // Meta domain verification code for <meta name="facebook-domain-verification">
  googleSiteVerification     String? // Google Search Console verification code for <meta name="google-site-verification">
  seoTitle                   String? // Custom store homepage SEO title
  seoKeywords                String? // Store-wide SEO keywords
  socialShareImageUrl        String? // Default OpenGraph / WhatsApp preview image URL
  richSnippetsEnabled        Boolean   @default(true) // Schema.org Product, Breadcrumbs, ReturnPolicy
  googleOAuthClientId        String? // Google OAuth 2.0 Client ID for storefront customer login
  googleOAuthClientSecret    String? // Google OAuth 2.0 Client Secret
  googleMerchantCenterId     String? // Google Merchant Center Account ID (Google Shopping)
  // AI Suite & Storefront Chatbot
  customGeminiApiKey         String? // Merchant BYO Gemini API Key
  aiChatbotEnabled           Boolean   @default(true)
  aiChatbotName              String    @default("শপ অ্যাসিস্ট্যান্ট")
  aiChatbotWelcome           String?
  aiChatbotEscalatePhone     String?
  aiChatbotInstructions      String? // Custom merchant business instructions, FAQs, and policies for AI grounding
  // Loyalty points, VIP tiers and referrals (docs/26)
  loyaltyEnabled             Boolean   @default(false)
  loyaltySpendPerPoint       Int       @default(100) // every ৳ this much of a delivered order earns 1 point (before the tier multiplier)
  loyaltyPointsPerBlock      Int       @default(10) // redeeming works in blocks: this many points ...
  loyaltyBdtPerBlock         Int       @default(10) // ... are worth this many taka
  loyaltyMaxCartPercent      Int       @default(30) // points can pay at most this share of the cart
  referralEnabled            Boolean   @default(false)
  refereeDiscountBdt         Int       @default(50) // a friend's first order
  refereeMinCartBdt          Int       @default(500)
  referrerRewardPoints       Int       @default(100) // credited when the friend's order is delivered
  loyaltyExpiryMonths        Int       @default(0) // points expire after this many months with no activity; 0 = never
  vipSilverMin               Int       @default(5000) // delivered spend in 12 months
  vipGoldMin                 Int       @default(15000)
  vipPlatinumMin             Int       @default(35000)
  vipGoldDiscount            Int       @default(5) // percent off every order
  vipPlatinumDiscount        Int       @default(10)
  birthdayVoucherBdt         Int       @default(100) // a voucher on a Silver-or-higher member's birthday; 0 = off
  // Affiliate & Influencer Hub
  affiliateEnabled           Boolean   @default(false)
  affiliateDefaultType       String    @default("PERCENTAGE") // "PERCENTAGE" | "FLAT"
  affiliateDefaultRate       Decimal   @default(10.00) @db.Decimal(10, 2)
  affiliateMinPayoutBdt      Decimal   @default(500.00) @db.Decimal(10, 2)
  affiliateCookieDays        Int       @default(30)

  // Wholesale & B2B Module
  wholesaleEnabled           Boolean   @default(false)
  wholesaleMinOrderAmount    Decimal   @default(5000.00) @db.Decimal(12, 2)
  wholesaleDefaultMoq        Int       @default(6)
  wholesaleAllowRegistration Boolean   @default(true)
  wholesaleBankDetails       Json?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-time sign-in codes for customers (StrAccount). Only a keyed hash of the code is stored.
model CustomerOtp {
  id         String    @id @default(cuid())
  tenantId   String
  phone      String // 01XXXXXXXXX
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ipAddress  String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, phone, createdAt])
  @@index([expiresAt])
}

// ==========================================
// ADMIN: ORDER TIMELINE AND STOCK HISTORY
// ==========================================

// What happened to an order, in plain words, for the Timeline on the order page (AdmOrderDetail). Append only.
model OrderEvent {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  type      String // "PLACED" | "PAYMENT_SUBMITTED" | "PAYMENT_VERIFIED" | "PAYMENT_REJECTED" | "STATUS" | "NOTE" | "PRINTED" | "ADDRESS_CHANGED"
  message   String
  actorId   String?
  actorName String? // "Customer", "System" or a staff member's name
  data      Json    @default("{}")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, orderId, createdAt])
}

// Every manual change to stock, with who and why. Orders and cancellations change stock too but are already on the order.
model StockAdjustment {
  id            String  @id @default(cuid())
  tenantId      String
  variantId     String
  productTitle  String
  variantTitle  String
  delta         Int
  quantityAfter Int
  reason        String // "RECOUNT" | "RECEIVED" | "DAMAGED" | "RETURNED" | "CORRECTION" | "OTHER"
  note          String?
  actorId       String
  actorName     String

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, createdAt])
}

// ==========================================
// PHASE 4: COURIER WEBHOOKS AND CROSS-STORE TRUST
// ==========================================

// Every courier callback and sync result we acted on (or ignored), so a repeated delivery changes nothing (docs/10 section 1).
model CourierEvent {
  id            String  @id @default(cuid())
  tenantId      String
  provider      String
  dedupeKey     String // hash of provider, consignment, status and the courier's timestamp
  orderId       String?
  consignmentId String?
  status        String? // normalised: BOOKED | PICKED_UP | IN_TRANSIT | HOLD | DELIVERED | RETURNED | REFUSED
  source        String  @default("WEBHOOK") // "WEBHOOK" | "SYNC"
  result        String // "APPLIED" | "IGNORED" | "UNKNOWN_ORDER" | "ERROR"
  payload       Json    @default("{}")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([tenantId, provider, dedupeKey])
  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
}

// One delivery outcome for one order, keyed by a salted hash of the phone number and a hash of the order (docs/12 section 1).
// No names, addresses or store ids. Platform level: the app role cannot read or write it except through the SECURITY DEFINER functions.
model PhoneTrustEvent {
  phoneHash  String
  orderKey   String // hash of tenant id and order id: one outcome per order, and it can be corrected
  storeKey   String // hash of tenant id: lets us count how many stores saw this number
  kind       String // "DELIVERED" | "RETURNED" | "REFUSED"
  occurredAt DateTime

  @@id([phoneHash, orderKey])
  @@index([phoneHash, occurredAt])
}

// An email or text the platform sent to a store (docs/44). The unique key is what stops a reminder going out twice.
model PlatformMessage {
  id        String   @id @default(cuid())
  tenantId  String
  kind      String // WELCOME, TRIAL_ENDING, PAYMENT_APPROVED ...
  channel   String // EMAIL | SMS
  dedupeKey String // the moment it is about, e.g. the payment's id or the date a trial ends
  status    String // SENT | FAILED | SKIPPED
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, channel, dedupeKey])
  @@index([tenantId, createdAt])
}

/// A message a shopper sent through the store contact form. Answered by SMS from the admin inbox.
model ContactMessage {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  phone      String
  email      String?
  message    String    @db.Text
  /// NEW until someone opens it, then READ, then REPLIED when an answer was sent, or CLOSED when it needs none.
  status     String    @default("NEW")
  replyText  String?   @db.Text
  repliedBy  String?
  repliedAt  DateTime?
  clientHash String?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, phone, createdAt])
}

/// A shopper asked to be told when a sold-out item is back. One request per phone per item; sent once.
model StockAlert {
  id         String    @id @default(cuid())
  tenantId   String
  variantId  String
  phone      String
  name       String?
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
  /// Why it was not sent when the item came back, for example the customer opted out or the plan has no SMS left.
  skipReason String?

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, phone])
  @@index([tenantId, notifiedAt])
}

// ==========================================
// 19. POINT OF SALE (POS) & CASH REGISTERS
// ==========================================

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

model PosRegister {
  id                  String  @id @default(cuid())
  tenantId            String
  name                String
  code                String
  isActive            Boolean @default(true)
  receiptPrinterWidth Int     @default(80)
  autoPrintReceipt    Boolean @default(true)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions PosSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PosSession {
  id             String  @id @default(cuid())
  tenantId       String
  registerId     String
  openedByUserId String
  closedByUserId String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openingFloat   Decimal  @db.Decimal(12, 2)
  closingCounted Decimal? @db.Decimal(12, 2)
  expectedCash   Decimal? @db.Decimal(12, 2)
  cashDifference Decimal? @db.Decimal(12, 2)

  note   String?
  status String  @default("OPEN")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register  PosRegister       @relation(fields: [registerId], references: [id], onDelete: Cascade)
  movements PosCashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, registerId, status])
  @@index([tenantId, openedAt])
}

model PosCashMovement {
  id        String           @id @default(cuid())
  tenantId  String
  sessionId String
  userId    String
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, sessionId])
}

model TenantQuotaAdjustment {
  id        String   @id @default(cuid())
  tenantId  String
  type      String // "SMS_CREDITS" | "PRODUCT_LIMIT" | "STAFF_LIMIT"
  amount    Int
  reason    String
  actorId   String // PlatformUser id
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

