model PublicToolUsage {
  id         String   @id @default(cuid())
  tool       String
  bucket     String
  count      Int      @default(0)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tool, bucket])
  @@index([tool, bucket])
}

// ==========================================
// 42. ASYNCHRONOUS NOTIFICATION OUTBOX & RETRY QUEUE (NOTIFY-001)
// ==========================================

model NotificationJob {
  id          String    @id @default(cuid())
  tenantId    String
  channel     String    @default("SMS") // "SMS" | "WHATSAPP" | "EMAIL"
  event       String    // "ORDER_RECEIVED" | "PAYMENT_CONFIRMED" | "ORDER_SHIPPED" | "DELIVERED" | "ORDER_CANCELLED" | "ABANDONED_RECOVERY" | "BUSINESS_INQUIRY"
  recipient   String
  body        String    @db.Text
  status      String    @default("PENDING") // "PENDING" | "SENT" | "FAILED" | "EXHAUSTED"
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime? @default(now())
  lastError   String?   @db.Text
  sentAt      DateTime?
  metadata    Json      @default("{}")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, nextRetryAt])
  @@index([status, nextRetryAt])
  @@index([tenantId, createdAt])
}

enum PlatformBlogStatus {
  DRAFT
  PUBLISHED
}

/// A guide on the marketing site (biztrack.bd/blog), written in Platform Admin. Not the same as BlogPost, which belongs to a store.
/// The body is plain text: blank lines split paragraphs, a line starting with "## " is a heading. The marketing site shows only
/// PUBLISHED rows whose publishedAt has passed.
model PlatformBlogPost {
  id          String             @id @default(cuid())
  slug        String             @unique
  title       String
  description String
  body        String             @db.Text
  ctaLabel    String?
  ctaHref     String?
  /// Overrides the title in Google and social cards (the site adds ' | BizTrackBD').
  seoTitle    String?
  /// Overrides the description in Google and social cards.
  seoDescription String?
  /// https address or /path. When empty the site draws a cover from the title.
  coverImage  String?
  coverAlt    String?
  noindex     Boolean            @default(false)
  status      PlatformBlogStatus @default(DRAFT)
  publishedAt DateTime?
  createdBy   String
  updatedBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, publishedAt])
}

/// Staff who get an email when something happens (new signup, inquiry, payment proof, ticket). Managed in Platform Admin.
model PlatformNotifyRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  label     String?
  events    String[] @default([])
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The feed of those events, shown in Platform Admin. Written through the platform_notify_record() database function.
model PlatformNotification {
  id        String   @id @default(cuid())
  kind      String
  title     String
  body      String   @db.Text
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Visitor sessions on the platform and marketing site, capturing Facebook ad attribution and campaign parameters.
model PlatformVisitorSession {
  id                 String                 @id
  fbclid             String?
  fbp                String?
  fbc                String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  referrer           String?
  landingPage        String
  exitPage           String?
  device             String?                @default("desktop")
  browser            String?
  os                 String?
  ipAddress          String?
  convertedToSignup  Boolean                @default(false)
  startedAt          DateTime               @default(now())
  lastActiveAt       DateTime               @default(now())
  durationSeconds    Int                    @default(0)

  events             PlatformVisitorEvent[]
  errors             PlatformClientError[]

  @@index([startedAt])
  @@index([utmCampaign])
  @@index([utmSource])
  @@index([fbclid])
}

/// Granular actions taken by a visitor (pageviews, clicks, CTA engagements, signup form steps).
model PlatformVisitorEvent {
  id         String                 @id @default(cuid())
  sessionId  String
  eventType  String                 // "PAGEVIEW" | "CLICK" | "CTA" | "SIGNUP"
  pagePath   String
  pageTitle  String?
  targetText String?
  targetHref String?
  metadata   Json                   @default("{}")
  createdAt  DateTime               @default(now())

  session    PlatformVisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([pagePath])
}

enum PlatformClientErrorStatus {
  NEW
  RESOLVED
  IGNORED
}

/// Client-side runtime crashes, uncaught exceptions, and frontend errors.
model PlatformClientError {
  id             String                    @id @default(cuid())
  sessionId      String?
  pageUrl        String
  message        String                    @db.Text
  stack          String?                   @db.Text
  component      String?
  browser        String?
  os             String?
  device         String?
  status         PlatformClientErrorStatus @default(NEW)
  count          Int                       @default(1)
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now())
  lastOccurredAt DateTime                  @default(now())

  session        PlatformVisitorSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([status, lastOccurredAt])
  @@index([pageUrl])
  @@index([createdAt])
}

/// Native mobile push notification device registration
model MobileDeviceToken {
  id           String   @id @default(cuid())
  appType      String   // "STORE_MANAGER" | "PLATFORM_ADMIN"
  tenantId     String?  // null for platform super admins
  userId       String   // TenantUser.id or PlatformUser.id
  pushToken    String   @unique // e.g. "ExponentPushToken[...]"
  platform     String   @default("android") // "android" | "ios"
  deviceModel  String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId, appType])
  @@index([userId, appType])
  @@index([appType, lastActiveAt])
}

