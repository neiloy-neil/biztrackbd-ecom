datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// ==========================================
// 1. PLATFORM & TENANT MANAGEMENT
// ==========================================

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlanTier {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MfsProvider {
  BKASH
  NAGAD
  ROCKET
  UPAY
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  subdomain       String       @unique
  customDomain    String?      @unique
  status          TenantStatus @default(TRIAL)
  planTier        PlanTier     @default(STARTER)
  themeId         String       @default("kapor")
  // The template this store was started from or last updated to (docs/46 stage 5), and the version it has. Null: built from one of the original looks, untouched.
  templateId      String?
  templateVersion Int?
  locale          String       @default("bn-BD")
  currency        String       @default("BDT")
  timezone        String       @default("Asia/Dhaka")

  // Storage & Limits Usage Counters
  productCount     Int    @default(0)
  orderCountMonth  Int    @default(0)
  nextOrderNumber  Int    @default(10001) // atomic per-tenant counter; never derive order numbers from count()
  orderPrefix      String @default("BT-") // shown on invoices and SMS, editable in store details
  storageBytesUsed BigInt @default(0)

  trialStartsAt DateTime @default(now())
  trialEndsAt   DateTime

  // Who signed the store up (the platform's search and support fields) and why it may be switched off
  ownerName        String?
  ownerEmail       String?
  ownerPhone       String?
  suspendedReason  String? // set when the platform (not an unpaid bill) switched the store off
  suspendedAt      DateTime?
  quarantined      Boolean   @default(false) // brand-review hold (docs/12 section 2)
  isDemo           Boolean   @default(false) // a template demo store (docs/38): left out of revenue, trials and billing, never suspended, never takes real orders
  demoKind         String? // TEMPLATE (a public demo store) or SESSION (a visitor's private, temporary copy: docs/41)
  demoTemplate     String? // the template a SESSION copy was made from
  demoExpiresAt    DateTime? // when a SESSION copy is deleted
  demoLastOrderAt  DateTime? // the last sample order dropped into a SESSION copy
  demoCreator      String? // hash of who started it (never an address), for the per-visitor limit
  demoKeepToken    String? // secret code that lets a signup carry this SESSION copy into a real store; cleared once used
  quarantineReason String?

  // BizTrack Business Site Mode & Vertical
  siteMode         String    @default("ECOMMERCE")
  businessVertical String?

  // Subdomain Change & Legacy Forwarding
  subdomainChangedAt         DateTime?
  previousSubdomain          String?   @unique
  previousSubdomainExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Platform Relations
  subscription  Subscription?
  paymentProofs PaymentProof[]
  auditLogs     AuditLog[]

  // Tenant Scoped Relations
  users                 TenantUser[]
  products              Product[]
  categories            Category[]
  orders                Order[]
  customers             Customer[]
  coupons               Coupon[]
  themeInstalls         ThemeInstall[]
  domains               Domain[]
  integrations          TenantIntegration[]
  abandonedCarts        AbandonedCheckout[]
  returnRequests        ReturnRequest[]
  reviews               Review[]
  shippingZones         ShippingZone[]
  pages                 Page[]
  blogPosts             BlogPost[]
  dailyMetrics          DailyStoreMetrics[]
  aiUsage               TenantAiUsage[]
  cartShortLinks        CartShortLink[]
  contactMessages       ContactMessage[]
  stockAlerts           StockAlert[]
  loyaltyAccounts       CustomerLoyaltyAccount[]
  referrals             CustomerReferral[]
  smsOptOuts            SmsOptOut[]
  apiKeys               ApiKeyCredential[]
  idempotencyRecords    ApiIdempotencyRecord[]
  apiRequestLogs        ApiRequestLog[]
  webhookSubs           WebhookSubscription[]
  landingPages          LandingPage[]
  landingDaily          LandingDaily[]
  landingLeads          LandingLead[]
  collections           Collection[]
  expenses              Expense[]
  courierEvents         CourierEvent[]
  blockedContacts       BlockedContact[]
  themeVersions         ThemeVersion[]
  messageTemplates      MessageTemplate[]
  campaigns             MarketingCampaign[]
  storeSettings         StoreSettings?
  posRegisters          PosRegister[]
  posSessions           PosSession[]
  posMovements          PosCashMovement[]
  orderEvents           OrderEvent[]
  stockAdjustments      StockAdjustment[]
  quotaAdjustments      TenantQuotaAdjustment[]
  customerOtps          CustomerOtp[]
  staffInvites          StaffInvite[]
  modules               TenantModule[]
  usageCounters         UsageCounter[]
  trackingEvents        TrackingEvent[]
  tickets               SupportTicket[]
  settlements           CourierSettlementInvoice[]
  notes                 TenantNote[]
  platformMessages      PlatformMessage[]
  productBundles        ProductBundle[]
  orderBumps            OrderBump[]
  bundleItems           ProductBundleItem[]
  whatsAppConfig        WhatsAppConfig?
  whatsAppTemplates     WhatsAppTemplate[]
  whatsAppMessageLogs   WhatsAppMessageLog[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppChatMessages  WhatsAppChatMessage[]
  wholesaleTiers        WholesaleTier[]
  wholesaleCustomers    WholesaleCustomer[]
  wholesalePrices       WholesalePrice[]
  supportQuickReplies   SupportQuickReply[]
  affiliatePartners     AffiliatePartner[]
  affiliateReferrals    AffiliateReferral[]
  affiliatePayouts      AffiliatePayout[]
  limitedDrops          LimitedDrop[]
  dropProducts          DropProduct[]
  dropSubscribers       DropWaitlistSubscriber[]

  // BizTrack Business Relations
  siteLeads             SiteLead[]
  bookingRequests       BookingRequest[]
  menuCategories        MenuCategory[]
  menuItems             MenuItem[]
  siteContentItems      SiteContentItem[]
  siteDownloads         SiteDownload[]
  notificationJobs      NotificationJob[]

  @@index([subdomain])
  @@index([customDomain])
  @@index([status])
  @@index([demoKind, demoExpiresAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planTier           PlanTier
  interval           BillingInterval    @default(MONTHLY)
  status             SubscriptionStatus @default(TRIALING)
  amount             Decimal            @db.Decimal(12, 2)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?

  gateway               String? // "SSLCOMMERZ" | "STRIPE" | "MANUAL_MFS"
  gatewaySubscriptionId String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model PaymentProof {
  id            String             @id @default(cuid())
  tenantId      String
  planTier      PlanTier
  billingPeriod BillingInterval
  amount        Decimal            @db.Decimal(12, 2)
  mfsProvider   MfsProvider
  senderNumber  String // 01XXXXXXXXX
  trxId         String             @unique
  screenshotUrl String?
  status        PaymentProofStatus @default(PENDING)

  approvedBy      String? // Platform Super Admin User ID
  approvedAt      DateTime?
  rejectionReason String?
  note            String? // the owner's own words, for example "paid from my wife's bKash"
  appliedFrom     DateTime? // the subscription period this payment bought
  appliedTo       DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([trxId])
}

// ==========================================
// 2. STAFF, ROLES & PERMISSIONS
// ==========================================

enum StaffRole {
  STORE_OWNER
  STORE_MANAGER
  ORDER_PACKER
  TELEMARKETER
  CONTENT_EDITOR
}

model TenantUser {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  phone        String?
  role         StaffRole @default(STORE_MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  authUserId   String? // the Supabase Auth account this person signs in with; set the first time they sign in with the confirmed email

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedWhatsAppConversations WhatsAppConversation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, authUserId])
  @@index([authUserId])
  @@index([tenantId, role])
}

// ==========================================
// 3. PRODUCTS, CATEGORIES & INVENTORY
// ==========================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String? @db.Text
  imageUrl    String?
  parentId    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model Product {
  id              String        @id @default(cuid())
  tenantId        String
  title           String
  titleBn         String?
  slug            String
  descriptionHtml String        @db.Text
  shortExcerpt    String?       @db.Text
  status          ProductStatus @default(DRAFT)

  basePrice      Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)

  sku        String?
  barcode    String?
  isFeatured Boolean  @default(false)
  tags       String[] @default([])
  moq        Int?     @default(1)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  orderItems  OrderItem[]
  collections CollectionProduct[]
  bundleItems ProductBundleItem[]
  orderBumps  OrderBump[]
  dropProducts DropProduct[]

  // SEO Fields
  seoTitle       String?
  seoDescription String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, productId, sortOrder])
}

model ProductVariant {
  id             String   @id @default(cuid())
  tenantId       String
  productId      String
  title          String // e.g. "L / Black"
  sku            String?
  barcode        String?
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stockQuantity  Int      @default(0) // single central warehouse per store (docs/05); no per-location stock
  reorderLevel   Int      @default(5)
  shelfCode      String? // optional bin or shelf label
  isActive       Boolean  @default(true)

  options  Json // { "Size": "L", "Color": "Black" }
  imageUrl String?

  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  stockAlerts     StockAlert[]
  bundleItems     ProductBundleItem[]
  orderBumps      OrderBump[]
  wholesalePrices WholesalePrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, sku])
  @@index([tenantId, barcode])
}

// ==========================================
// 4. ORDERS, PAYMENTS, COURIERS & FRAUD
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentMethodType {
  COD
  CASH
  MANUAL_BKASH
  MANUAL_NAGAD
  MANUAL_ROCKET
  GATEWAY_SSLCOMMERZ
  GATEWAY_BKASH
  GATEWAY_STRIPE
  GATEWAY_UDDOKTAPAY
  BANK_TRANSFER
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  PAPERFLY
  MANUAL
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Order {
  id             String  @id @default(cuid())
  tenantId       String
  orderNumber    String // e.g. "ORD-10024"
  idempotencyKey String?

  customerId    String?
  customerName  String
  customerPhone String // 01XXXXXXXXX
  customerEmail String?

  shippingAddress    String
  shippingCity       String
  shippingDistrict   String
  shippingDivision   String
  shippingPostalCode String?
  deliveryZone       String // "INSIDE_DHAKA" | "OUTSIDE_DHAKA"

  status        OrderStatus       @default(PENDING)
  paymentStatus PaymentStatus     @default(UNPAID)
  paymentMethod PaymentMethodType @default(COD)

  // Financial Calculations
  subtotalAmount      Decimal @db.Decimal(12, 2)
  deliveryCharge      Decimal @db.Decimal(12, 2)
  codFee              Decimal @default(0.00) @db.Decimal(12, 2) // store rule: extra charge for cash on delivery
  discountAmount      Decimal @default(0.00) @db.Decimal(12, 2)
  loyaltyPointsUsed   Int     @default(0)
  loyaltyDiscountBdt  Decimal @default(0.00) @db.Decimal(12, 2)
  tierDiscountBdt     Decimal @default(0.00) @db.Decimal(12, 2) // the VIP tier's permanent discount
  referralDiscountBdt Decimal @default(0.00) @db.Decimal(12, 2) // the friend's first-order discount
  referralCode        String?
  priorityPacking     Boolean @default(false) // a Gold or Platinum member's order: packed first
  clientHash          String? // keyed hash of the buyer's address, only to spot a referral from the referrer's own connection
  deliveryWaived      Boolean @default(false) // delivery was free because of the member's level or a coupon, so editing the address keeps it free
  totalAmount         Decimal @db.Decimal(12, 2)
  isWholesale         Boolean @default(false)
  advancePaidAmount   Decimal @default(0.00) @db.Decimal(12, 2)
  balanceDue          Decimal @default(0.00) @db.Decimal(12, 2)
  isPreOrder          Boolean @default(false)
  preOrderDropId      String?
  b2bCompanyName      String?
  b2bTaxId            String?
  b2bTradeLicense     String?

  couponId   String?
  couponCode String?

  // Manual MFS Verification Details
  mfsSenderNumber String?
  mfsTrxId        String?
  mfsVerifiedAt   DateTime?
  mfsVerifiedBy   String?

  // Courier & Consignment Details
  courierProvider    CourierProvider?
  consignmentId      String?
  trackingCode       String?
  courierTrackingUrl String?
  courierBookingFee  Decimal?         @db.Decimal(12, 2)
  courierBookedAt    DateTime?
  courierStatus      String? // the courier's own status word, shown to the owner
  courierStatusAt    DateTime?
  courierSyncedAt    DateTime? // last time the 30-minute sync looked at this parcel
  courierBookingLock DateTime? // set while a booking call is in flight, so two clicks cannot book twice
  deliveredAt        DateTime?
  returnedAt         DateTime?
  refusedAtDoor      Boolean          @default(false)
  trustRecorded      String? // which outcome (DELIVERED | RETURNED | REFUSED) was sent to the cross-store trust record
  fraudReview        String? // "HELD" waits for the owner, "CLEARED" was released
  settlementStatus   SettlementStatus @default(PENDING_DELIVERY) // doc 28 COD reconciliation

  // Fraud Engine Delivery Trust Score
  fraudRiskLevel  FraudRiskLevel @default(LOW)
  fraudTrustScore Int            @default(85) // 0-100
  fraudFlags      String[]       @default([])

  // Source Attribution
  channel         String  @default("STOREFRONT") // "STOREFRONT" | "LANDING_PAGE" | "WHATSAPP_BOT" | "MESSENGER_BOT" | "TELEMARKETING" | "QUICK_MESSENGER" | "QUICK_WHATSAPP" | "QUICK_PHONE" | "QUICK_INSTAGRAM"
  createdByUserId String? // staff who keyed in a quick order
  utmSource       String?
  utmCampaign     String?
  utmMedium       String?
  // The landing page this order came from, when it did (docs/46)
  landingPageId   String?
  posRegisterId   String?
  posSessionId    String?
  paymentSplits   Json?

  notes      String?  @db.Text
  staffNotes String?  @db.Text
  /**
   * Short labels the team puts on an order, for example "call first" or "gift".
   */
  tags       String[] @default([])
  /**
   * What was said on the confirmation call. Shown at the top of the order for whoever packs it.
   */
  callNote   String?  @db.Text

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon              Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  stateLogs           OrderStateLog[]
  events              OrderEvent[]
  refunds             RefundLedger[]
  settledLines        CourierSettledOrder[]
  affiliateReferrals  AffiliateReferral[]
  courierEvents       CourierEvent[]
  whatsAppMessageLogs WhatsAppMessageLog[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, customerPhone])
  @@index([tenantId, clientHash])
  @@index([tenantId, createdAt])
  @@index([tenantId, consignmentId])
  @@index([tenantId, status, courierSyncedAt])
  @@index([tenantId, landingPageId])
  @@index([tags], type: Gin) // the label filter on the orders list (migration 28)
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String
  orderId   String
  productId String
  variantId String?

  productTitle String
  variantTitle String?
  sku          String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  unitCost     Decimal? @db.Decimal(12, 2) // product cost at the time of the order, for the profit screen
  quantity     Int
  totalPrice   Decimal  @db.Decimal(12, 2)

  bundleId    String?
  bundleTitle String?
  isBump      Boolean @default(false)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  bundle  ProductBundle?  @relation(fields: [bundleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, orderId])
  @@index([productId])
  @@index([variantId])
  @@index([bundleId])
}

model OrderStateLog {
  id         String      @id @default(cuid())
  tenantId   String
  orderId    String
  fromStatus OrderStatus
  toStatus   OrderStatus
  actorType  String // "MERCHANT" | "CUSTOMER" | "COURIER_WEBHOOK" | "SYSTEM_CRON"
  actorId    String?
  reason     String?
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([createdAt])
}

model RefundLedger {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  method      String // "BKASH_SEND_MONEY" | "GATEWAY_REVERSAL" | "STORE_CREDIT"
  trxId       String?
  processedBy String
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

// ==========================================
// 5. CUSTOMERS, CRM & LOYALTY
// ==========================================

enum VipTierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN_PURCHASE
  REDEEM_PURCHASE
  REFERRAL_BONUS
  TIER_BONUS
  MANUAL_ADJUSTMENT
  EXPIRED
}

enum LoyaltyTxStatus {
  PENDING
  CONFIRMED
  VOIDED
}

model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  phone           String // 01XXXXXXXXX
  email           String?
  totalOrders     Int      @default(0)
  totalSpent      Decimal  @default(0.00) @db.Decimal(12, 2)
  deliveryScore   Int      @default(90) // 0-100
  isBlacklisted   Boolean  @default(false)
  blacklistReason String?
  storeCredit     Decimal  @default(0.00) @db.Decimal(12, 2) // issued by a return; spending it at checkout is not built yet
  tags            String[] @default([])
  smsConsent      Boolean  @default(false)
  birthMonth      Int? // optional, given by the customer; with the day it earns a birthday voucher
  birthDay        Int?
  emailConsent    Boolean  @default(false)
  notes           String? // private note for the team

  addresses             CustomerAddress[]
  orders                Order[]
  reviews               Review[]
  loyaltyAccount        CustomerLoyaltyAccount?
  wholesaleProfile      WholesaleCustomer?
  whatsAppConversations WhatsAppConversation[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, totalSpent])
  @@index([tenantId, isBlacklisted])
}

model CustomerAddress {
  id         String  @id @default(cuid())
  tenantId   String
  customerId String
  label      String  @default("Home") // "Home" | "Office"
  address    String
  district   String
  division   String
  upazila    String? // upazila or thana
  isDefault  Boolean @default(false)

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, customerId])
}

model CustomerLoyaltyAccount {
  id                  String       @id @default(cuid())
  tenantId            String
  customerId          String       @unique
  availablePoints     Int          @default(0)
  pendingPoints       Int          @default(0)
  lifetimePoints      Int          @default(0)
  currentTier         VipTierLevel @default(BRONZE)
  rollingSpend12m     Decimal      @default(0.00) @db.Decimal(12, 2)
  referralCode        String       @unique
  birthdayVoucherYear Int? // the last year a birthday voucher was sent

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions  LoyaltyTransaction[]
  referralsMade CustomerReferral[]   @relation("Referrer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, customerId])
  @@index([referralCode])
}

model LoyaltyTransaction {
  id          String          @id @default(cuid())
  tenantId    String
  accountId   String
  orderId     String?
  points      Int
  amountBdt   Decimal?        @db.Decimal(12, 2)
  type        LoyaltyTxType
  status      LoyaltyTxStatus @default(PENDING)
  description String
  expiresAt   DateTime?

  account   CustomerLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())

  @@unique([accountId, orderId, type]) // one earn, one redeem, one bonus per order: a repeated delivery cannot credit twice
  @@index([tenantId, accountId])
  @@index([orderId])
  @@index([expiresAt])
}

model CustomerReferral {
  id              String    @id @default(cuid())
  tenantId        String
  referrerId      String
  refereePhone    String
  firstOrderId    String?   @unique
  bonusPoints     Int       @default(100)
  isDelivered     Boolean   @default(false)
  rewardClaimedAt DateTime?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrerAccount CustomerLoyaltyAccount @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  createdAt       DateTime               @default(now())

  @@unique([tenantId, refereePhone])
  @@index([tenantId, referrerId])
  @@index([refereePhone])
}

// ==========================================
// 6. TELEMARKETING, CHAT & ABANDONED CARTS
// ==========================================

enum AbandonedStatus {
  CAPTURED
  CALL_SCHEDULED
  CALL_CONNECTED
  RECOVERED
  LOST
}

model AbandonedCheckout {
  id           String          @id @default(cuid())
  tenantId     String
  phone        String // 01XXXXXXXXX
  customerName String?
  cartItems    Json // Array of variantId, quantity, price
  cartTotal    Decimal         @db.Decimal(12, 2)
  status       AbandonedStatus @default(CAPTURED)

  callAttempts   Int       @default(0)
  lastCallAt     DateTime?
  callAgentNotes String?   @db.Text
  recoveryUrl    String
  recoveryToken  String?   @unique // the secret in the link the customer is sent; it restores their cart
  district       String?
  outcome        String? // last call outcome: "WILL_ORDER" | "NO_ANSWER" | "NOT_INTERESTED" | "ORDER_CREATED"
  lastEventAt    DateTime  @default(now()) // last time the customer touched the checkout; the 30-minute wait counts from here
  smsClaimedAt   DateTime? // set the moment a recovery SMS is claimed, so two sweeps cannot send it twice
  smsSentAt      DateTime?
  smsStatus      String? // "SENT" | "FAILED" | "SKIPPED_OPTOUT" | "SKIPPED_NO_CREDITS" | "SKIPPED_LIMIT"

  recoveredOrderId String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
}

model CartShortLink {
  id          String   @id @default(cuid())
  tenantId    String
  shortCode   String   @unique
  payloadJson Json // Items, customer info, coupon, channel attribution
  source      String // "WHATSAPP_BOT" | "MESSENGER_BOT" | "TELEMARKETING"
  clicksCount Int      @default(0)
  isConverted Boolean  @default(false)
  orderId     String?
  expiresAt   DateTime

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, shortCode])
  @@index([expiresAt])
}

model SmsOptOut {
  id       String  @id @default(cuid())
  tenantId String
  phone    String // 01XXXXXXXXX
  reason   String? // "USER_STOP_REQUEST" | "BOUNCED"

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ==========================================
// 7. AI ENGINE & USAGE QUOTAS
// ==========================================

model TenantAiUsage {
  id              String  @id @default(cuid())
  tenantId        String
  periodMonth     String // "YYYY-MM"
  generationCount Int     @default(0)
  tokenCount      Int     @default(0)
  customApiKey    String? // AES-256 encrypted BYO Gemini Key

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, periodMonth])
  @@index([tenantId])
}

// ==========================================
// 8. API CREDENTIALS & OUTBOUND WEBHOOKS
// ==========================================

model ApiKeyCredential {
  id          String    @id @default(cuid())
  tenantId    String
  name        String // e.g. "ManyChat Production Bot"
  keyPrefix   String // "bzk_live_..."
  hashedToken String    @unique // SHA-256 hash of secret token
  environment String    @default("LIVE") // "LIVE" | "TEST"
  scopes      String[] // ["orders:read", "orders:write", "products:read"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  isActive    Boolean   @default(true)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestLogs ApiRequestLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([tenantId, keyPrefix])
  @@index([tenantId, isActive])
}

model ApiIdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  idempotencyKey String
  endpoint       String
  statusCode     Int
  responseBody   String   @db.Text
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([expiresAt])
}

model ApiRequestLog {
  id         String   @id @default(cuid())
  tenantId   String
  apiKeyId   String?
  keyPrefix  String?
  endpoint   String
  method     String
  statusCode Int
  ipAddress  String?
  durationMs Int
  createdAt  DateTime @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKey ApiKeyCredential? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  targetUrl   String
  events      String[] // ["order.created", "order.delivered", "inventory.low"]
  secretToken String // AES-256 encrypted signing secret
  isActive    Boolean  @default(true)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryLogs WebhookDeliveryLog[]
  createdAt    DateTime             @default(now())

  @@index([tenantId, isActive])
}

model WebhookDeliveryLog {
  id             String  @id @default(cuid())
  tenantId       String
  subscriptionId String
  eventId        String
  eventType      String
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempt        Int     @default(1)
  isSuccess      Boolean @default(false)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@index([tenantId, subscriptionId, createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  idempotencyKey String
  responseJson   Json
  statusCode     Int
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([tenantId, idempotencyKey])
  @@index([expiresAt])
}

// ==========================================
// 9. THEMES, MARKETING & CMS
// ==========================================

model ThemeInstall {
  id        String  @id @default(cuid())
  tenantId  String
  themeId   String // "kapor" | "gadgetstudio" | "mini-bunny" | "axionwear" | "bindu" | "berber", see docs/06 for display names
  isActive  Boolean @default(false)
  settings  Json // Custom color/font/banner tokens
  pagesJson Json // Sections & block trees per route
  version   Int     @default(1)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, themeId])
  @@index([tenantId, isActive])
}

model LandingPage {
  id              String         @id @default(cuid())
  tenantId        String
  title           String
  slug            String
  targetProductId String
  sectionsJson    Json // Page builder block layout
  isPublished     Boolean        @default(false)
  pixelId         String?
  // What the page sells (docs/46): one product, a choice of products, bundle deals and an optional order bump. Null = the one product above.
  offersJson      Json?
  // The short address for ads: /p/<shortCode>
  shortCode       String?        @unique
  daily           LandingDaily[]
  leads           LandingLead[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

// Views and orders of a landing page, one row per day (docs/46). Counts only: no visitor is identified.
model LandingDaily {
  landingPageId String
  day           DateTime @db.Date
  tenantId      String
  views         Int      @default(0)
  orders        Int      @default(0)

  page   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([landingPageId, day])
  @@index([tenantId, day])
}

// A visitor who typed a name and number on a landing page and may not have finished (docs/46). Kept 30 days, shown to the seller to call.
model LandingLead {
  id            String   @id @default(cuid())
  tenantId      String
  landingPageId String
  name          String
  phone         String
  offerLabel    String?
  utmSource     String?
  utmCampaign   String?
  // NEW until an order from the same number arrives, then ORDERED
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  page   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, phone])
  @@index([tenantId, createdAt])
}

model Coupon {
  id               String    @id @default(cuid())
  tenantId         String
  code             String
  type             String // "PERCENTAGE" | "FIXED_AMOUNT" | "FREE_SHIPPING"
  value            Decimal   @db.Decimal(12, 2)
  minOrderValue    Decimal?  @db.Decimal(12, 2)
  usageLimit       Int?
  usageCount       Int       @default(0)
  perCustomerLimit Int       @default(1)
  startsAt         DateTime  @default(now())
  expiresAt        DateTime?
  isActive         Boolean   @default(true)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Review {
  id            String    @id @default(cuid())
  tenantId      String
  productId     String
  customerId    String
  rating        Int       @default(5)
  title         String?
  body          String    @db.Text
  photos        String[]  @default([])
  isVerified    Boolean   @default(true)
  isPublished   Boolean   @default(true)
  merchantReply String?   @db.Text
  repliedAt     DateTime?
  decidedAt     DateTime? // when the owner published or hid it; null while it waits
  orderId       String? // the delivered order that made this a verified review

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, productId, customerId])
  @@index([tenantId, productId])
}

model ShippingZone {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  districts      String[]
  rate           Decimal  @db.Decimal(12, 2)
  freeOverAmount Decimal? @db.Decimal(12, 2)
  etaMinDays     Int      @default(1) // shown at checkout: "Arrives in 1 to 2 days"
  etaMaxDays     Int      @default(3)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Page {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  slug           String
  contentHtml    String    @db.Text
  isPublished    Boolean   @default(true)
  publishAt      DateTime? // when set, the page appears at that time even if isPublished is on
  // A page built from sections in the visual editor (docs/47 part D). Null: a rich-text page, shown from contentHtml.
  sectionsJson   Json?
  seoTitle       String?
  seoDescription String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model BlogPost {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  summary     String?
  contentHtml String    @db.Text
  coverImage  String?
  authorName  String?
  tags        String[]  @default([])
  isPublished Boolean   @default(true)
  publishAt   DateTime? // when set, the post appears at that time even if isPublished is on

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Domain {
  id            String    @id @default(cuid())
  tenantId      String
  domain        String    @unique
  verified      Boolean   @default(false)
  isPrimary     Boolean   @default(false)
  redirectWww   Boolean   @default(true) // 308 canonical redirect, docs/13
  dnsStatus     String    @default("waiting") // "waiting" | "wrong_record" | "found" | "verified"
  dnsNote       String? // plain-language reason shown to the owner
  sslStatus     String    @default("pending") // "pending" | "issued" | "renewal_failed" | "expiring"
  lastCheckedAt DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum IntegrationMode {
  TEST
  LIVE
}

enum IntegrationStatus {
  CONNECTED
  NEEDS_ATTENTION
  DISABLED
}

model TenantIntegration {
  id               String            @id @default(cuid())
  tenantId         String
  provider         String // "STEADFAST" | "PATHAO" | "REDX" | "SSLCOMMERZ" | "META_CAPI" | "GA4" | "BREVO_BYO" | "SMS_BYO"
  mode             IntegrationMode   @default(TEST)
  config           Json              @default("{}") // NON-secret: store name, pickup id, pixel id, sender name
  secretCipher     String // AES-256-GCM encrypted secrets JSON (base64), write-only from the UI (docs/04, docs/17)
  secretKeyId      String // which data key encrypted it; supports rotation
  integrationToken String            @unique // random token in the webhook URL, identifies the tenant without exposing ids
  status           IntegrationStatus @default(CONNECTED)
  lastVerifiedAt   DateTime?
  lastError        String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider, mode])
  @@index([tenantId])
}

model ReturnRequest {
  id                  String    @id @default(cuid())
  tenantId            String
  orderId             String
  code                String // "RT-0412"
  reason              String
  customerNote        String?   @db.Text
  type                String    @default("REFUND") // "EXCHANGE" | "REFUND" | "STORE_CREDIT"
  items               Json      @default("[]") // [{ orderItemId, qty }]
  refundAmount        Decimal?  @db.Decimal(12, 2)
  exchangeVariantId   String?
  returnConsignmentId String? // courier pickup for the returning parcel
  status              String    @default("PENDING") // "PENDING" | "APPROVED" | "PICKUP_BOOKED" | "RECEIVED" | "REFUNDED" | "DECLINED"
  photos              String[]  @default([])
  decidedBy           String?
  decidedAt           DateTime?
  adminNote           String?
  returnTrackingCode  String?
  exchangeReserved    Boolean   @default(false) // the replacement was taken off the shelf when the return was approved
  receivedAt          DateTime?
  restocked           Boolean   @default(false)
  refundMethod        String? // "BKASH_SEND_MONEY" | "STORE_CREDIT"
  refundTrxId         String?
  refundedAt          DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

model DailyStoreMetrics {
  id       String   @id @default(cuid())
  tenantId String
  date     DateTime @db.Date // 2026-10-10

  // Financials
  grossSalesBDT     Decimal @default(0.00) @db.Decimal(12, 2)
  netSalesBDT       Decimal @default(0.00) @db.Decimal(12, 2)
  discountsTotalBDT Decimal @default(0.00) @db.Decimal(12, 2)
  shippingTotalBDT  Decimal @default(0.00) @db.Decimal(12, 2)
  refundsTotalBDT   Decimal @default(0.00) @db.Decimal(12, 2)

  // Volume & conversions
  totalOrders     Int @default(0)
  paidOrders      Int @default(0)
  codOrders       Int @default(0)
  cancelledOrders Int @default(0)
  returnedOrders  Int @default(0)

  // AOV & customers
  averageOrderValue Decimal @default(0.00) @db.Decimal(12, 2)
  newCustomersCount Int     @default(0)
  repeatOrdersCount Int     @default(0)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model AuditLog {
  id         String  @id @default(cuid())
  tenantId   String
  action     String
  actorId    String
  actorEmail String
  details    Json    @default("{}")
  ipAddress  String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ==========================================
// 11. PLANS, USAGE & MODULES (added 10 Oct 2026)
// ==========================================

// PLATFORM-LEVEL (no tenantId). Limits live here, never in code (docs/05: prices and limits are hypotheses).
// A store template that BizTrackBD staff publish without a deploy (docs/46 stage 5): a colour and style preset plus a layout for each page,
// on top of one of the original "looks" (baseLook, the CSS a template is drawn with). The six original templates exist in code; a row with the
// same id replaces one of them. Platform table: stores may read published and archived rows, only the platform role writes.
model Template {
  id             String    @id
  name           String
  blurb          String    @default("")
  audience       String    @default("")
  baseLook       String
  category       String    @default("other")
  tags           String[]  @default([])
  moduleLabel    String?
  // DRAFT | PUBLISHED | ARCHIVED
  status         String    @default("DRAFT")
  version        Int       @default(1)
  settingsJson   Json
  // { home, product, collection, cart }: each a page layout (see builder registry)
  pagesJson      Json
  // The workshop store it was last published from
  sourceTenantId String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model Plan {
  tier            PlanTier @id
  name            String
  priceMonthlyBdt Decimal  @db.Decimal(12, 2)
  priceYearlyBdt  Decimal  @db.Decimal(12, 2)
  trialDays       Int      @default(14)
  isPublic        Boolean  @default(true)
  sortOrder       Int      @default(0)
  // { "products": 300, "ordersPerMonth": 500, "staff": 2, "storageGb": 5, "smsCredits": 200, "landingPages": 3, "aiCredits": 50 }  (null = unlimited)
  limits          Json
  // { "customDomain": false, "courierBooking": "manual", "fraud": "basic", "sectionBuilder": "settings", "modules": 0, "paymentGateway": false, "capi": true }
  features        Json
  // products: hard limit. ordersPerMonth: soft, +10% grace with warning, checkout never blocked (docs/05)
  overagePolicy   Json     @default("{\"products\":\"hard\",\"ordersPerMonth\":\"soft_10pct\"}")
  updatedAt       DateTime @updatedAt
}

model UsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  metric      String // "products" | "orders" | "sms" | "storage_bytes" | "ai_credits" | "emails"
  periodStart DateTime @db.Date // first day of the month, or epoch for non-periodic metrics
  value       BigInt   @default(0)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
}

model TenantModule {
  id        String  @id @default(cuid())
  tenantId  String
  moduleKey String // "bespoke" | "drops" | "baby_profiles" | "loyalty" | "booking" | "wholesale"
  isEnabled Boolean @default(true)
  settings  Json    @default("{}")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabledAt DateTime @default(now())

  @@unique([tenantId, moduleKey])
}

// ==========================================
// 12. CATALOG ORGANISATION, FINANCE, RISK, MESSAGING
// ==========================================

model Collection {
  id          String  @id @default(cuid())
  tenantId    String
  title       String
  titleBn     String?
  slug        String
  isAutomatic Boolean @default(false) // rule-based collection
  rules       Json?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  CollectionProduct[]
  createdAt DateTime            @default(now())

  @@unique([tenantId, slug])
}

model CollectionProduct {
  id           String @id @default(cuid())
  tenantId     String
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([tenantId, productId])
}

// Costs the platform cannot see, entered by the owner for the P&L screen (docs/28 section 7)
model Expense {
  id         String   @id @default(cuid())
  tenantId   String
  category   String // "ADS" | "PACKAGING" | "RENT_SALARY" | "OTHER"
  note       String?
  amount     Decimal  @db.Decimal(12, 2)
  incurredOn DateTime @db.Date
  createdBy  String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, incurredOn])
}

// Per-store blocklist (docs/12). The cross-store trust score lives in PhoneTrustStat (platform level).
model BlockedContact {
  id        String  @id @default(cuid())
  tenantId  String
  phone     String
  reason    String
  source    String  @default("MANUAL") // "MANUAL" | "FRAUD_REVIEW" | "REFUSED_PARCELS"
  createdBy String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
}

// Draft and published page JSON for the section builder and landing page builder (docs/06)
model ThemeVersion {
  id           String  @id @default(cuid())
  tenantId     String
  themeId      String
  pageKey      String // "home" | "product" | "collection" | "landing:<slug>"
  state        String // "DRAFT" | "PUBLISHED"
  settings     Json
  sectionsJson Json
  version      Int
  label        String?
  createdBy    String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // a draft's last save: the editor sends it back, so two people cannot silently overwrite each other

  @@unique([tenantId, themeId, pageKey, state, version])
  @@index([tenantId, themeId, pageKey, state])
}

model MessageTemplate {
  id        String  @id @default(cuid())
  tenantId  String
  event     String // "ORDER_RECEIVED" | "PAYMENT_CONFIRMED" | "ORDER_SHIPPED" | "OUT_FOR_DELIVERY" | "DELIVERED" | "ORDER_CANCELLED" | "ABANDONED_RECOVERY"
  channel   String // "SMS" | "EMAIL" | "WHATSAPP"
  locale    String // "en" | "bn"
  body      String  @db.Text // placeholders: {customer_name} {order_number} {tracking_link} {store_name}
  isEnabled Boolean @default(true)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, event, channel, locale])
}

model MarketingCampaign {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  channel         String // "SMS" | "EMAIL" | "WHATSAPP"
  targetSegment   String // "ALL" | "VIP" | "REPEAT" | "DORMANT" | "DHAKA" | "OUTSIDE_DHAKA" | "ABANDONED_CART"
  subject         String? // For email campaigns
  body            String    @db.Text
  mediaUrl        String?   // Optional image/banner URL
  couponCode      String?   // Optional attached discount coupon
  recipientsCount Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  creditsUsed     Int       @default(0)
  status          String    @default("SENT") // "DRAFT" | "SCHEDULED" | "SENDING" | "SENT" | "PAUSED" | "CANCELLED" | "FAILED"
  scheduledFor    DateTime?
  sentAt          DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, status, scheduledFor])
}

model StaffInvite {
  id         String    @id @default(cuid())
  tenantId   String
  email      String
  role       StaffRole
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, email])
}

// Pixel and Conversions API event log, used for browser vs server dedup and the match table (docs/11)
model TrackingEvent {
  id         String  @id @default(cuid())
  tenantId   String
  provider   String // "META" | "GA4"
  name       String // "PageView" | "ViewContent" | "AddToCart" | "InitiateCheckout" | "AddPaymentInfo" | "Purchase"
  eventId    String // shared id used for deduplication
  origin     String // "BROWSER" | "SERVER"
  status     String  @default("SENT") // "SENT" | "FAILED" | "DEDUPED"
  orderId    String?
  payload    Json    @default("{}") // what was reported: value, currency, item ids (never a name, phone or address)
