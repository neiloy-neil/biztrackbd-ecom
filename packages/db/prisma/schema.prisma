datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// ==========================================
// 1. PLATFORM & TENANT MANAGEMENT
// ==========================================

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PlanTier {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MfsProvider {
  BKASH
  NAGAD
  ROCKET
  UPAY
}

model Tenant {
  id               String       @id @default(cuid())
  name             String
  subdomain        String       @unique
  customDomain     String?      @unique
  status           TenantStatus @default(TRIAL)
  planTier         PlanTier     @default(STARTER)
  themeId          String       @default("kapor")
  locale           String       @default("bn-BD")
  currency         String       @default("BDT")
  timezone         String       @default("Asia/Dhaka")
  
  // Storage & Limits Usage Counters
  productCount     Int          @default(0)
  orderCountMonth  Int          @default(0)
  nextOrderNumber  Int          @default(10001)   // atomic per-tenant counter; never derive order numbers from count()
  orderPrefix      String       @default("BT-")    // shown on invoices and SMS, editable in store details
  storageBytesUsed BigInt       @default(0)
  
  trialStartsAt    DateTime     @default(now())
  trialEndsAt      DateTime

  // Who signed the store up (the platform's search and support fields) and why it may be switched off
  ownerName        String?
  ownerEmail       String?
  ownerPhone       String?
  suspendedReason  String?      // set when the platform (not an unpaid bill) switched the store off
  suspendedAt      DateTime?
  quarantined      Boolean      @default(false)   // brand-review hold (docs/12 section 2)
  isDemo           Boolean      @default(false)   // a template demo store (docs/38): left out of revenue, trials and billing, never suspended, never takes real orders
  quarantineReason String?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Platform Relations
  subscription     Subscription?
  paymentProofs    PaymentProof[]
  auditLogs        AuditLog[]
  
  // Tenant Scoped Relations
  users            TenantUser[]
  products         Product[]
  categories       Category[]
  orders           Order[]
  customers        Customer[]
  coupons          Coupon[]
  themeInstalls    ThemeInstall[]
  domains          Domain[]
  integrations     TenantIntegration[]
  abandonedCarts   AbandonedCheckout[]
  returnRequests   ReturnRequest[]
  reviews          Review[]
  shippingZones    ShippingZone[]
  pages            Page[]
  blogPosts        BlogPost[]
  dailyMetrics     DailyStoreMetrics[]
  aiUsage          TenantAiUsage[]
  cartShortLinks   CartShortLink[]
  loyaltyAccounts  CustomerLoyaltyAccount[]
  referrals        CustomerReferral[]
  smsOptOuts       SmsOptOut[]
  apiKeys          ApiKeyCredential[]
  webhookSubs      WebhookSubscription[]
  landingPages     LandingPage[]
  collections      Collection[]
  expenses         Expense[]
  courierEvents    CourierEvent[]
  blockedContacts  BlockedContact[]
  themeVersions    ThemeVersion[]
  messageTemplates MessageTemplate[]
  storeSettings    StoreSettings?
  orderEvents      OrderEvent[]
  stockAdjustments StockAdjustment[]
  customerOtps     CustomerOtp[]
  staffInvites     StaffInvite[]
  modules          TenantModule[]
  usageCounters    UsageCounter[]
  trackingEvents   TrackingEvent[]
  tickets          SupportTicket[]
  settlements      CourierSettlementInvoice[]

  @@index([subdomain])
  @@index([customDomain])
  @@index([status])
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  planTier             PlanTier
  interval             BillingInterval    @default(MONTHLY)
  status               SubscriptionStatus @default(TRIALING)
  amount               Decimal            @db.Decimal(12, 2)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  
  gateway              String?            // "SSLCOMMERZ" | "STRIPE" | "MANUAL_MFS"
  gatewaySubscriptionId String?
  
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

model PaymentProof {
  id             String             @id @default(cuid())
  tenantId       String
  planTier       PlanTier
  billingPeriod  BillingInterval
  amount         Decimal            @db.Decimal(12, 2)
  mfsProvider    MfsProvider
  senderNumber   String             // 01XXXXXXXXX
  trxId          String             @unique
  screenshotUrl  String?
  status         PaymentProofStatus @default(PENDING)
  
  approvedBy     String?            // Platform Super Admin User ID
  approvedAt     DateTime?
  rejectionReason String?
  note           String?            // the owner's own words, for example "paid from my wife's bKash"
  appliedFrom    DateTime?          // the subscription period this payment bought
  appliedTo      DateTime?
  
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([trxId])
}

// ==========================================
// 2. STAFF, ROLES & PERMISSIONS
// ==========================================

enum StaffRole {
  STORE_OWNER
  STORE_MANAGER
  ORDER_PACKER
  TELEMARKETER
  CONTENT_EDITOR
}

model TenantUser {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  phone        String?
  role         StaffRole @default(STORE_MANAGER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  authUserId   String?   // the Supabase Auth account this person signs in with; set the first time they sign in with the confirmed email
  
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@unique([tenantId, authUserId])
  @@index([authUserId])
  @@index([tenantId, role])
}

// ==========================================
// 3. PRODUCTS, CATEGORIES & INVENTORY
// ==========================================

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?   @db.Text
  imageUrl    String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
}

model Product {
  id              String         @id @default(cuid())
  tenantId        String
  title           String
  titleBn         String?
  slug            String
  descriptionHtml String         @db.Text
  shortExcerpt    String?        @db.Text
  status          ProductStatus  @default(DRAFT)
  
  basePrice       Decimal        @db.Decimal(12, 2)
  compareAtPrice  Decimal?       @db.Decimal(12, 2)
  costPrice       Decimal?       @db.Decimal(12, 2)
  
  sku             String?
  barcode         String?
  isFeatured      Boolean        @default(false)
  tags            String[]       @default([])
  
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  images          ProductImage[]
  variants        ProductVariant[]
  reviews         Review[]
  orderItems      OrderItem[]
  collections     CollectionProduct[]
  
  // SEO Fields
  seoTitle        String?
  seoDescription  String?
  
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, isFeatured])
}

model ProductImage {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tenantId, productId, sortOrder])
}

model ProductVariant {
  id             String      @id @default(cuid())
  tenantId       String
  productId      String
  title          String      // e.g. "L / Black"
  sku            String?
  barcode        String?
  price          Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?    @db.Decimal(12, 2)
  stockQuantity  Int         @default(0)   // single central warehouse per store (docs/05); no per-location stock
  reorderLevel   Int         @default(5)
  shelfCode      String?     // optional bin or shelf label
  
  options        Json        // { "Size": "L", "Color": "Black" }
  imageUrl       String?
  
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([tenantId, productId])
  @@index([tenantId, sku])
}

// ==========================================
// 4. ORDERS, PAYMENTS, COURIERS & FRAUD
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum PaymentMethodType {
  COD
  MANUAL_BKASH
  MANUAL_NAGAD
  MANUAL_ROCKET
  GATEWAY_SSLCOMMERZ
  GATEWAY_STRIPE
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  PAPERFLY
  MANUAL
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Order {
  id                  String            @id @default(cuid())
  tenantId            String
  orderNumber         String            // e.g. "ORD-10024"
  idempotencyKey      String?
  
  customerId          String?
  customerName        String
  customerPhone       String            // 01XXXXXXXXX
  customerEmail       String?
  
  shippingAddress     String
  shippingCity        String
  shippingDistrict    String
  shippingDivision    String
  shippingPostalCode  String?
  deliveryZone        String            // "INSIDE_DHAKA" | "OUTSIDE_DHAKA"
  
  status              OrderStatus       @default(PENDING)
  paymentStatus       PaymentStatus     @default(UNPAID)
  paymentMethod       PaymentMethodType @default(COD)
  
  // Financial Calculations
  subtotalAmount      Decimal           @db.Decimal(12, 2)
  deliveryCharge      Decimal           @db.Decimal(12, 2)
  codFee              Decimal           @default(0.00) @db.Decimal(12, 2)   // store rule: extra charge for cash on delivery
  discountAmount      Decimal           @default(0.00) @db.Decimal(12, 2)
  loyaltyPointsUsed   Int               @default(0)
  loyaltyDiscountBdt  Decimal           @default(0.00) @db.Decimal(12, 2)
  tierDiscountBdt     Decimal           @default(0.00) @db.Decimal(12, 2)   // the VIP tier's permanent discount
  referralDiscountBdt Decimal           @default(0.00) @db.Decimal(12, 2)   // the friend's first-order discount
  referralCode        String?
  priorityPacking     Boolean           @default(false)   // a Gold or Platinum member's order: packed first
  clientHash          String?           // keyed hash of the buyer's address, only to spot a referral from the referrer's own connection
  deliveryWaived      Boolean           @default(false)   // delivery was free because of the member's level or a coupon, so editing the address keeps it free
  totalAmount         Decimal           @db.Decimal(12, 2)
  
  couponId            String?
  couponCode          String?
  
  // Manual MFS Verification Details
  mfsSenderNumber     String?
  mfsTrxId            String?
  mfsVerifiedAt       DateTime?
  mfsVerifiedBy       String?
  
  // Courier & Consignment Details
  courierProvider     CourierProvider?
  consignmentId       String?
  trackingCode        String?
  courierTrackingUrl  String?
  courierBookingFee   Decimal?          @db.Decimal(12, 2)
  courierBookedAt     DateTime?
  courierStatus       String?           // the courier's own status word, shown to the owner
  courierStatusAt     DateTime?
  courierSyncedAt     DateTime?         // last time the 30-minute sync looked at this parcel
  courierBookingLock  DateTime?         // set while a booking call is in flight, so two clicks cannot book twice
  deliveredAt         DateTime?
  returnedAt          DateTime?
  refusedAtDoor       Boolean           @default(false)
  trustRecorded       String?           // which outcome (DELIVERED | RETURNED | REFUSED) was sent to the cross-store trust record
  fraudReview         String?           // "HELD" waits for the owner, "CLEARED" was released
  settlementStatus    SettlementStatus  @default(PENDING_DELIVERY)  // doc 28 COD reconciliation
  
  // Fraud Engine Delivery Trust Score
  fraudRiskLevel      FraudRiskLevel    @default(LOW)
  fraudTrustScore     Int               @default(85) // 0-100
  fraudFlags          String[]          @default([])
  
  // Source Attribution
  channel             String            @default("STOREFRONT") // "STOREFRONT" | "LANDING_PAGE" | "WHATSAPP_BOT" | "MESSENGER_BOT" | "TELEMARKETING" | "QUICK_MESSENGER" | "QUICK_WHATSAPP" | "QUICK_PHONE" | "QUICK_INSTAGRAM"
  createdByUserId     String?           // staff who keyed in a quick order
  utmSource           String?
  utmCampaign         String?
  
  notes               String?           @db.Text
  staffNotes          String?           @db.Text
  
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer            Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon              Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  stateLogs           OrderStateLog[]
  events              OrderEvent[]
  refunds             RefundLedger[]
  settledLines        CourierSettledOrder[]
  courierEvents       CourierEvent[]
  
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, customerPhone])
  @@index([tenantId, clientHash])
  @@index([tenantId, createdAt])
  @@index([tenantId, consignmentId])
  @@index([tenantId, status, courierSyncedAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  tenantId       String
  orderId        String
  productId      String
  variantId      String?
  
  productTitle   String
  variantTitle   String?
  sku            String?
  unitPrice      Decimal         @db.Decimal(12, 2)
  unitCost       Decimal?        @db.Decimal(12, 2)   // product cost at the time of the order, for the profit screen
  quantity       Int
  totalPrice     Decimal         @db.Decimal(12, 2)
  
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime        @default(now())

  @@index([tenantId, orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStateLog {
  id          String      @id @default(cuid())
  tenantId    String
  orderId     String
  fromStatus  OrderStatus
  toStatus    OrderStatus
  actorType   String      // "MERCHANT" | "CUSTOMER" | "COURIER_WEBHOOK" | "SYSTEM_CRON"
  actorId     String?
  reason      String?
  createdAt   DateTime    @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([createdAt])
}

model RefundLedger {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  method      String   // "BKASH_SEND_MONEY" | "GATEWAY_REVERSAL" | "STORE_CREDIT"
  trxId       String?
  processedBy String
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

// ==========================================
// 5. CUSTOMERS, CRM & LOYALTY
// ==========================================

enum VipTierLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyTxType {
  EARN_PURCHASE
  REDEEM_PURCHASE
  REFERRAL_BONUS
  TIER_BONUS
  MANUAL_ADJUSTMENT
  EXPIRED
}

enum LoyaltyTxStatus {
  PENDING
  CONFIRMED
  VOIDED
}

model Customer {
  id               String                 @id @default(cuid())
  tenantId         String
  name             String
  phone            String                 // 01XXXXXXXXX
  email            String?
  totalOrders      Int                    @default(0)
  totalSpent       Decimal                @default(0.00) @db.Decimal(12, 2)
  deliveryScore    Int                    @default(90) // 0-100
  isBlacklisted    Boolean                @default(false)
  blacklistReason  String?
  storeCredit      Decimal                @default(0.00) @db.Decimal(12, 2)   // issued by a return; spending it at checkout is not built yet
  tags             String[]               @default([])
  smsConsent       Boolean                @default(false)
  birthMonth       Int?                   // optional, given by the customer; with the day it earns a birthday voucher
  birthDay         Int?
  emailConsent     Boolean                @default(false)
  notes            String?                // private note for the team
  
  addresses        CustomerAddress[]
  orders           Order[]
  reviews          Review[]
  loyaltyAccount   CustomerLoyaltyAccount?
  
  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([tenantId, phone])
  @@index([tenantId, totalSpent])
  @@index([tenantId, isBlacklisted])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  label      String   @default("Home") // "Home" | "Office"
  address    String
  district   String
  division   String
  upazila    String?  // upazila or thana
  isDefault  Boolean  @default(false)
  
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([tenantId, customerId])
}

model CustomerLoyaltyAccount {
  id              String         @id @default(cuid())
  tenantId        String
  customerId      String         @unique
  availablePoints Int            @default(0)
  pendingPoints   Int            @default(0)
  lifetimePoints  Int            @default(0)
  currentTier     VipTierLevel   @default(BRONZE)
  rollingSpend12m Decimal        @default(0.00) @db.Decimal(12, 2)
  referralCode    String         @unique
  birthdayVoucherYear Int?       // the last year a birthday voucher was sent
  
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions    LoyaltyTransaction[]
  referralsMade   CustomerReferral[] @relation("Referrer")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId, customerId])
  @@index([referralCode])
}

model LoyaltyTransaction {
  id          String          @id @default(cuid())
  tenantId    String
  accountId   String
  orderId     String?
  points      Int
  amountBdt   Decimal?        @db.Decimal(12, 2)
  type        LoyaltyTxType
  status      LoyaltyTxStatus @default(PENDING)
  description String
  expiresAt   DateTime?
  
  account     CustomerLoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  @@unique([accountId, orderId, type])   // one earn, one redeem, one bonus per order: a repeated delivery cannot credit twice
  @@index([tenantId, accountId])
  @@index([orderId])
  @@index([expiresAt])
}

model CustomerReferral {
  id              String   @id @default(cuid())
  tenantId        String
  referrerId      String
  refereePhone    String
  firstOrderId    String?  @unique
  bonusPoints     Int      @default(100)
  isDelivered     Boolean  @default(false)
  rewardClaimedAt DateTime?
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrerAccount CustomerLoyaltyAccount @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([tenantId, refereePhone])
  @@index([tenantId, referrerId])
  @@index([refereePhone])
}

// ==========================================
// 6. TELEMARKETING, CHAT & ABANDONED CARTS
// ==========================================

enum AbandonedStatus {
  CAPTURED
  CALL_SCHEDULED
  CALL_CONNECTED
  RECOVERED
  LOST
}

model AbandonedCheckout {
  id             String          @id @default(cuid())
  tenantId       String
  phone          String          // 01XXXXXXXXX
  customerName   String?
  cartItems      Json            // Array of variantId, quantity, price
  cartTotal      Decimal         @db.Decimal(12, 2)
  status         AbandonedStatus @default(CAPTURED)
  
  callAttempts   Int             @default(0)
  lastCallAt     DateTime?
  callAgentNotes String?         @db.Text
  recoveryUrl    String
  recoveryToken  String?         @unique   // the secret in the link the customer is sent; it restores their cart
  district       String?
  outcome        String?         // last call outcome: "WILL_ORDER" | "NO_ANSWER" | "NOT_INTERESTED" | "ORDER_CREATED"
  lastEventAt    DateTime        @default(now())   // last time the customer touched the checkout; the 30-minute wait counts from here
  smsClaimedAt   DateTime?       // set the moment a recovery SMS is claimed, so two sweeps cannot send it twice
  smsSentAt      DateTime?
  smsStatus      String?         // "SENT" | "FAILED" | "SKIPPED_OPTOUT" | "SKIPPED_NO_CREDITS" | "SKIPPED_LIMIT"
  
  recoveredOrderId String?
  
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
}

model CartShortLink {
  id          String   @id @default(cuid())
  tenantId    String
  shortCode   String   @unique
  payloadJson Json     // Items, customer info, coupon, channel attribution
  source      String   // "WHATSAPP_BOT" | "MESSENGER_BOT" | "TELEMARKETING"
  clicksCount Int      @default(0)
  isConverted Boolean  @default(false)
  orderId     String?
  expiresAt   DateTime
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([tenantId, shortCode])
  @@index([expiresAt])
}

model SmsOptOut {
  id        String   @id @default(cuid())
  tenantId  String
  phone     String   // 01XXXXXXXXX
  reason    String?  // "USER_STOP_REQUEST" | "BOUNCED"
  
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ==========================================
// 7. AI ENGINE & USAGE QUOTAS
// ==========================================

model TenantAiUsage {
  id              String   @id @default(cuid())
  tenantId        String
  periodMonth     String   // "YYYY-MM"
  generationCount Int      @default(0)
  tokenCount      Int      @default(0)
  customApiKey    String?  // AES-256 encrypted BYO Gemini Key
  
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, periodMonth])
  @@index([tenantId])
}

// ==========================================
// 8. API CREDENTIALS & OUTBOUND WEBHOOKS
// ==========================================

model ApiKeyCredential {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    // e.g. "ManyChat Production Bot"
  keyPrefix   String    // "bzk_live_..."
  hashedToken String    // bcrypt hash of full secret
  scopes      String[]  // ["orders:read", "orders:write", "products:read"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([tenantId, keyPrefix])
}

model WebhookSubscription {
  id            String               @id @default(cuid())
  tenantId      String
  targetUrl     String
  events        String[]             // ["order.created", "order.delivered", "inventory.low"]
  secretToken   String               // AES-256 encrypted signing secret
  isActive      Boolean              @default(true)
  
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryLogs  WebhookDeliveryLog[]
  createdAt     DateTime             @default(now())

  @@index([tenantId, isActive])
}

model WebhookDeliveryLog {
