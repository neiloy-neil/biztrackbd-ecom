  @@index([productId])
  @@index([variantId])
}

enum BumpTriggerType {
  GLOBAL
  PRODUCT
  CATEGORY
}

enum BumpStatus {
  ACTIVE
  INACTIVE
}

model OrderBump {
  id               String          @id @default(cuid())
  tenantId         String
  title            String
  titleBn          String?
  highlightText    String?
  highlightTextBn  String?
  description      String?         @db.Text
  descriptionBn    String?         @db.Text
  productId        String
  variantId        String
