enum SiteLeadType {
  CONTACT
  QUOTE
  APPOINTMENT
  RESERVATION
  MEDIA_BOOKING
}

enum SiteLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  CLOSED
  SPAM
}

model SiteLead {
  id               String             @id @default(cuid())
  tenantId         String
  type             SiteLeadType       @default(CONTACT)
  status           SiteLeadStatus     @default(NEW)
  name             String
  phone            String?
  email            String?
  message          String?
  metadata         Json?              // Structured request metadata
  sourcePage       String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  referrer         String?
  locale           String             @default("en")
  consentGivenAt   DateTime?
  privateNotes     String?
  assignedToUserId String?            // Staff actor assigned to this lead

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookingRequest   BookingRequest?
  activities       SiteLeadActivity[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedToUserId])
}

enum LeadActivityType {
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  WHATSAPP_CLICKED
  CALL_LOGGED
  EMAIL_DISPATCHED
}

model SiteLeadActivity {
  id           String           @id @default(cuid())
  tenantId     String
  leadId       String
  actorId      String           // Staff user ID or "VISITOR" or "SYSTEM"
  actorName    String
  activityType LeadActivityType
  note         String?          @db.Text
  beforeStatus SiteLeadStatus?
  afterStatus  SiteLeadStatus?
  metadata     Json?            // e.g. { durationSecs: 180, templateUsed: "booking_confirmation" }
  createdAt    DateTime         @default(now())

  lead         SiteLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
}


enum BookingRequestStatus {
  REQUESTED
  CONTACTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

model BookingRequest {
  id            String               @id @default(cuid())
  tenantId      String
  leadId        String?              @unique
  serviceName   String?
  providerName  String?              // e.g. Doctor name or Staff specialist
  requestedDate DateTime?
  requestedTime String?              // e.g. "10:30 AM" or "Evening Chamber"
  partySize     Int?                 // e.g. For restaurant reservation
  status        BookingRequestStatus @default(REQUESTED)
  privateNotes  String?

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead          SiteLead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, requestedDate])
}

model MenuCategory {
  id            String     @id @default(cuid())
  tenantId      String
  name          String
  nameBn        String?
  description   String?
  descriptionBn String?
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         MenuItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tenantId, sortOrder])
  @@index([tenantId, isActive])
}

model MenuItem {
  id            String       @id @default(cuid())
  tenantId      String
  categoryId    String
  name          String
  nameBn        String?
  description   String?
  descriptionBn String?
  price         Decimal      @db.Decimal(12, 2)
  compareAtPrice Decimal?    @db.Decimal(12, 2)
  imageUrl      String?
  dietaryLabels Json?        // e.g. ["halal", "spicy", "vegetarian", "chef_special"]
  isAvailable   Boolean      @default(true)
  sortOrder     Int          @default(0)

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

