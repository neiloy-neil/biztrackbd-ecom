  @@index([tenantId, triggerType])
}

// ==========================================
// 15. AUTOMATED WHATSAPP COMMERCE SUITE (ZERO-META)
// ==========================================

enum WhatsAppProviderMode {
  QR_SESSION
  GATEWAY_API
  MANUAL_LINKS
}

enum WhatsAppSessionStatus {
  DISCONNECTED
  SCAN_QR
  CONNECTED
  PAIRING
  ERROR
}

enum WhatsAppEventType {
  COD_CONFIRMATION
  ORDER_CONFIRMED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  ABANDONED_CART_STAGE_1
  ABANDONED_CART_STAGE_2
}

enum WhatsAppMessageDirection {
  OUTBOUND
  INBOUND
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  FALLBACK_TO_SMS
}

enum WhatsAppConversationStatus {
  BOT_HANDLED
  OPEN
  RESOLVED
}

model WhatsAppConfig {
  id                       String                @id @default(cuid())
  tenantId                 String                @unique
  providerMode             WhatsAppProviderMode  @default(QR_SESSION)
  status                   WhatsAppSessionStatus @default(DISCONNECTED)
  phoneNumber              String?
  sessionData              String?               @db.Text
  qrCodeData               String?               @db.Text
  gatewayUrl               String?
  gatewayApiKey            String?
  webhookSecret            String?
  autoConfirmCod           Boolean               @default(true)
  shippingUpdatesEnabled   Boolean               @default(true)
  abandonedRecoveryEnabled Boolean               @default(true)
  botEnabled               Boolean               @default(true)
  smsFallbackEnabled       Boolean               @default(true)
  followUpReminderHours    Int                   @default(12)
  lastConnectedAt          DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WhatsAppTemplate {
  id        String            @id @default(cuid())
  tenantId  String
  event     WhatsAppEventType
  name      String
  bodyEn    String            @db.Text
  bodyBn    String?           @db.Text
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, event])
  @@index([tenantId])
}

model WhatsAppMessageLog {
  id            String                   @id @default(cuid())
  tenantId      String
  orderId       String?
  phone         String
  direction     WhatsAppMessageDirection @default(OUTBOUND)
  event         WhatsAppEventType?
  status        WhatsAppMessageStatus    @default(QUEUED)
  messageBody   String                   @db.Text
  externalMsgId String?
  errorDetails  String?                  @db.Text
  metadata      Json?
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  createdAt     DateTime                 @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, phone])
  @@index([tenantId, orderId])
  @@index([tenantId, event, status])
}

model WhatsAppConversation {
  id              String                     @id @default(cuid())
  tenantId        String
  customerId      String?
  customerPhone   String
  customerName    String?
  status          WhatsAppConversationStatus @default(BOT_HANDLED)
  unreadCount     Int                        @default(0)
  lastMessageAt   DateTime                   @default(now())
  lastMessageText String?                    @db.Text
  assignedUserId  String?
  botPausedUntil  DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser TenantUser?           @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     WhatsAppChatMessage[]

  @@unique([tenantId, customerPhone])
  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assignedUserId])
}

model WhatsAppChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  tenantId       String
  sender         String // "CUSTOMER" | "BOT" | "STAFF"
  staffUserId    String?
  body           String   @db.Text
  mediaUrl       String?
  externalMsgId  String?
  createdAt      DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
}

model SupportQuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  shortcut  String   // e.g. "confirm", "bkash", "delivery", "address"
  title     String   // e.g. "Order Confirmation"
  body      String   @db.Text
  category  String   @default("General") // "General" | "Orders" | "Payments" | "Delivery"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@index([tenantId, category])
}

// ==========================================
// 16. WHOLESALE & B2B PRICING MODULE
// ==========================================

enum WholesaleApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model WholesaleTier {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String // e.g. "Standard Reseller", "VIP Distributor"
  discountPercent       Decimal  @default(15.00) @db.Decimal(5, 2)
  minOrderAmount        Decimal  @default(5000.00) @db.Decimal(12, 2)
  allowCod              Boolean  @default(false)
  partialDepositPercent Decimal? @db.Decimal(5, 2) // e.g. 20.00%

  customers     WholesaleCustomer[]
  productPrices WholesalePrice[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model WholesaleCustomer {
  id              String                     @id @default(cuid())
  tenantId        String
  customerId      String                     @unique
  tierId          String?
  companyName     String // Store or Boutique name
  tradeLicense    String?
  businessType    String? // "Physical Shop" | "Facebook Page" | "Online Store"
  taxId           String? // BIN / TIN
  whatsappNumber  String?
  address         String?
  district        String?
  status          WholesaleApplicationStatus @default(PENDING)
  approvedAt      DateTime?
  rejectionReason String?
  creditLimit     Decimal                    @default(0.00) @db.Decimal(12, 2)

  customer  Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier      WholesaleTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, tierId])
}

model WholesalePrice {
  id          String  @id @default(cuid())
  tenantId    String
  variantId   String
  tierId      String? // null = applies to all wholesale customers or public volume breaks
  minQuantity Int     @default(1)
  price       Decimal @db.Decimal(12, 2)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tier      WholesaleTier? @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([variantId, tierId, minQuantity])
  @@index([tenantId, variantId])
}

// ==========================================
// AFFILIATE & INFLUENCER COMMISSION HUB
// ==========================================

model AffiliatePartner {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String
  code           String              // unique referral code per store e.g. "tanvir"
  couponCode     String?             // unique discount coupon e.g. "TANVIR10"
  commissionType String              @default("PERCENTAGE") // "PERCENTAGE" | "FLAT"
  commissionValue Decimal            @default(10.00) @db.Decimal(10, 2)
  status         String              @default("ACTIVE") // "ACTIVE" | "PAUSED" | "ARCHIVED"
  payoutMethod   String              @default("BKASH") // "BKASH" | "NAGAD" | "ROCKET" | "BANK"
  payoutAccount  String?             // e.g. "01712345678" or bank details
  totalEarned    Decimal             @default(0.00) @db.Decimal(12, 2)
  totalPaid      Decimal             @default(0.00) @db.Decimal(12, 2)
  payableBalance Decimal             @default(0.00) @db.Decimal(12, 2)
  portalToken    String              @unique @default(uuid())
  notes          String?             @db.Text

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrals      AffiliateReferral[]
  payouts        AffiliatePayout[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model AffiliateReferral {
  id               String           @id @default(cuid())
  tenantId         String
  affiliateId      String
  orderId          String
  customerPhone    String
  orderSubtotal    Decimal          @db.Decimal(12, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  commissionType   String           // "PERCENTAGE" | "FLAT"
  commissionValue  Decimal          @db.Decimal(10, 2)
  status           String           @default("PENDING") // "PENDING" | "APPROVED" | "PAID" | "VOID"
  attributedVia    String           @default("LINK") // "LINK" | "COUPON"
  settledAt        DateTime?

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliate        AffiliatePartner @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId, affiliateId])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

model AffiliatePayout {
  id            String           @id @default(cuid())
  tenantId      String
  affiliateId   String
  amount        Decimal          @db.Decimal(12, 2)
  method        String           // "BKASH" | "NAGAD" | "ROCKET" | "BANK"
  accountNumber String
  bankDetails   String?          @db.Text
  status        String           @default("REQUESTED") // "REQUESTED" | "PAID" | "REJECTED"
  trxId         String?          // MFS TrxID or Bank reference
  notes         String?          @db.Text
  requestedAt   DateTime         @default(now())
  processedAt   DateTime?

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliate     AffiliatePartner @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, affiliateId])
  @@index([tenantId, status])
}

// ==========================================
// 26. LIMITED DROPS & PRE-ORDERS
// ==========================================

enum DropMode {
  TEASER_WAITLIST
  LIVE_PREORDER
}

enum DropStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum DropDepositType {
  NONE
  FIXED
  PERCENTAGE
  FULL
}

model LimitedDrop {
  id                String          @id @default(cuid())
  tenantId          String
  title             String
  slug              String
  description       String?         @db.Text
  bannerImage       String?
  mode              DropMode        @default(LIVE_PREORDER)
  status            DropStatus      @default(DRAFT)
  startsAt          DateTime
  endsAt            DateTime?
  estimatedShipDate DateTime?
  depositType       DropDepositType @default(NONE)
  depositValue      Decimal         @default(0.00) @db.Decimal(10, 2)
  allocationCap     Int?
  claimedUnits      Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products          DropProduct[]
  subscribers       DropWaitlistSubscriber[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, startsAt])
}

model DropProduct {
  id           String      @id @default(cuid())
  tenantId     String
  dropId       String
  productId    String
  variantId    String?
  allocatedQty Int?

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drop         LimitedDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dropId, productId, variantId])
  @@index([tenantId, dropId])
}

model DropWaitlistSubscriber {
  id         String      @id @default(cuid())
  tenantId   String
  dropId     String
  phone      String
  name       String?
  notifiedAt DateTime?
  createdAt  DateTime    @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drop       LimitedDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@unique([dropId, phone])
  @@index([tenantId, dropId, notifiedAt])
}

