    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@biztrackbd/tsconfig": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
