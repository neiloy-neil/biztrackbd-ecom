{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "TEST_DIRECT_URL",
    "TEST_DATABASE_URL",
    "PG_BIN",
    "RUN_LIVE_SUPABASE",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "DATABASE_URL",
    "DIRECT_URL",
    "PLATFORM_DATABASE_URL",
    "DB_POOL_MAX",
    "SUPABASE_PUBLISHABLE_KEY",
    "CRON_SECRET",
    "CUSTOMER_AUTH_SECRET",
    "INTEGRATION_VAULT_SECRET",
    "PREVIEW_SECRET",
    "PHONE_TRUST_SALT",
    "INTEGRATION_VAULT_KEY_ID",
    "ADMIN_ORIGIN",
    "MEDIA_DRIVER",
    "MEDIA_BUCKET",
    "PLATFORM_A_RECORD",
    "PLATFORM_CNAME_TARGET",
    "PLATFORM_VERCEL_PROJECT_ID",
    "PLATFORM_VERCEL_TEAM_ID",
    "SMS_PROVIDER",
    "SMS_NET_BD_API_KEY",
    "EMAIL_FROM",
    "EMAIL_FROM_NAME",
    "PLATFORM_BKASH_NUMBER",
    "PLATFORM_BKASH_KIND",
    "PLATFORM_NAGAD_NUMBER",
    "PLATFORM_NAGAD_KIND",
    "BREVO_API_KEY",
    "META_APP_ID",
    "META_APP_SECRET",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_STORE_DOMAIN",
    "NEXT_PUBLIC_PLATFORM_DOMAIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "@biztrackbd/db#typecheck": {
      "dependsOn": [
        "build"
      ]
    },
    "@biztrackbd/db#test": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
