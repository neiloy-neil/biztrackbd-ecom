# Copy to .env.local (gitignored). Never commit real values.
# Full catalog and notes: docs/17-environment-variables-and-configuration.md

# --- Database (Supabase Postgres in production) ---
# Runtime connection as the restricted role (NOBYPASSRLS), see docs/08 section 3
DATABASE_URL="postgresql://biztrack_app:app_password@127.0.0.1:54329/biztrack_dev"
# Migrations and seed run as the owner role
DIRECT_URL="postgresql://postgres@127.0.0.1:54329/biztrack_dev"
# Tests (separate database)
TEST_DATABASE_URL="postgresql://biztrack_app:app_password@127.0.0.1:54329/biztrack_test"
TEST_DIRECT_URL="postgresql://postgres@127.0.0.1:54329/biztrack_test"
# Super admin only (BYPASSRLS role). Leave unset in admin and storefront.
PLATFORM_DATABASE_URL=""

# --- Domains ---
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# --- Secrets vault (docs/04, 17). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_VAULT_SECRET=""
INTEGRATION_VAULT_KEY_ID="v1"

# --- Dev auth stub for Phase 0 only. Production uses Supabase Auth.
DEV_AUTH="1"

# Signs customer sign-in sessions and keys OTP hashes. 32+ random characters.
CUSTOMER_AUTH_SECRET=""

# Salt for the cross-store delivery trust hashes (docs/12). 32+ random characters, the SAME in every app, and never changed
# (changing it makes the network forget every number). Falls back to CUSTOMER_AUTH_SECRET if unset; required in production.
PHONE_TRUST_SALT=""

# Authorises the 30-minute courier sync: GET or POST /api/cron/courier-sync with "Authorization: Bearer <this>". 16+ random characters.
CRON_SECRET=""

# Development and end-to-end tests only: point a courier at a local stand-in (apps/admin/e2e/fake-courier.mjs).
# Ignored when NODE_ENV=production, so a stray value cannot redirect real parcels.
# COURIER_BASE_URL_STEADFAST="http://localhost:4010"

# --- Phase 5: signup, billing and the super admin ---
# The super admin app only: connects as the BYPASSRLS biztrack_platform role. Never set it in the storefront, store admin or marketing app.
# PLATFORM_DATABASE_URL="postgresql://biztrack_platform:<password>@127.0.0.1:54329/biztrack_dev"
# Where stores send subscription money (the platform's own bKash and Nagad). Shown on every store's billing screen.
PLATFORM_BKASH_NUMBER=""
PLATFORM_BKASH_KIND="MERCHANT"
PLATFORM_NAGAD_NUMBER=""
PLATFORM_NAGAD_KIND="MERCHANT"
# Public addresses the marketing site links to.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3002"

# --- Phase 6: growth tools ---
# The platform's shared SMS account (abandoned-checkout recovery, sign-in codes). Unset: development logs the message, production refuses.
GREENWEB_SMS_TOKEN=""
# Development and end-to-end tests only: point the Conversions API at a local fake. Ignored when NODE_ENV=production.
# META_GRAPH_URL="http://localhost:4011"

# --- Phase 7: store design, landing pages and domains ---
# Signs the editor's preview link. The SAME value in the store admin and the storefront. 16+ random characters (falls back to CRON_SECRET).
PREVIEW_SECRET=""
# What owners point their domain at: an A record to this address (bare domains) or a CNAME to this name (subdomains).
PLATFORM_A_RECORD="76.76.21.21"
PLATFORM_CNAME_TARGET="cname.biztrackbd.com"
# Adds custom domains to the storefront's Vercel project and reads their state. Without these a correct DNS record waits at "getting the certificate".
PLATFORM_VERCEL_TOKEN=""
PLATFORM_VERCEL_PROJECT_ID=""
# PLATFORM_VERCEL_TEAM_ID=""  # Vercel refuses variable names that start with VERCEL_, so these are PLATFORM_VERCEL_*
# Development and end-to-end tests only (apps/admin/e2e/fake-vercel.mjs and a DNS answers file). Both are ignored or unsafe in production: leave unset.
# PLATFORM_VERCEL_API_URL="http://localhost:4012"
# DEV_DNS_FILE="apps/admin/e2e/.dns.json"

# --- Phase 8: backups and drills ---
# Encrypts backups (AES-256-GCM). 64 hex characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a second copy away from the database host: without it a backup cannot be opened.
BACKUP_ENCRYPTION_KEY_HEX=""
# Folder with pg_dump and psql when they are not on PATH (the restore drill and `pnpm drill:backup`).
# PG_BIN="C:/Program Files/PostgreSQL/16/bin"

# --- Phase 10: real sign-in, storage and the daily loyalty job ---
# The Supabase project (Authentication and Storage). The publishable/anon key may be public; the service role key is server-only and
# never goes in code, docs or chat. Without SUPABASE_URL the apps refuse to sign anyone in outside development.
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Development only: the stand-in sign-in (the role switcher). Ignored when NODE_ENV=production. Leave unset against a real project.
# DEV_AUTH="1"
# Where product pictures are kept: "local" (a folder, development) or "supabase" (the public bucket below). Backups use a private bucket "backups".
# MEDIA_DRIVER="supabase"
# MEDIA_BUCKET="store-media"
# Opt-in: the tests that talk to the real Supabase project (storage and backup drills). Off by default.
# RUN_LIVE_SUPABASE="1"


# --- Found in the 11 October 2026 checkup (see docs/17) ---
# The public address of the store admin, used in staff invitation links.
# ADMIN_ORIGIN="https://admin.biztrackbd.com"
# Connections per app process. Keep low behind the Supabase pooler.
# DB_POOL_MAX="5"
# Marketing site address (canonical links, robots.txt, sitemap.xml) and where "See a live store" points.
# NEXT_PUBLIC_MARKETING_URL="https://biztrackbd.com"
# NEXT_PUBLIC_DEMO_STORE_URL="https://rongdhonu.biztrackbd.com"
# Vercel Edge Config for host routing.
# EDGE_CONFIG=""
# Development only: which store the stand-in sign-in acts in.
# DEV_TENANT_SUBDOMAIN="rongdhonu"
# The two restricted database logins for the Supabase project (see docs/17: three different logins).
# SUPABASE_DB_URL=""
# SUPABASE_APP_DB_URL=""
# SUPABASE_PLATFORM_DB_URL=""

# --- Messaging ---
# SMS: smsnetbd (sms.net.bd) or greenweb. The key is the account's API key; keep it out of the repository.
# SMS_PROVIDER="smsnetbd"
# SMS_NET_BD_API_KEY=""
# SMS_SENDER_ID=""
# Email (Brevo transactional API).
# BREVO_API_KEY=""
# EMAIL_FROM="no-reply@biztrack.bd"
# EMAIL_FROM_NAME="BizTrackBD"
